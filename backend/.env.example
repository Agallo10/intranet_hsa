# Intranet API environment
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=andresgallo
DATABASE_PASSWORD=
DATABASE_NAME=intranet

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# CORS (opcional, separado por comas; por defecto deshabilitado)
# CORS_ORIGIN=https://intranet.hospital.local

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=2048

# Seed admin (first run)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_FULLNAME=Administrador
