# ============================================================
# Variables de entorno para PRODUCCIÓN (Docker Compose)
# Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env
# ============================================================

# --- Secretos JWT (obligatorios; genera con: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Base de datos PostgreSQL (obligatorio) ---
POSTGRES_PASSWORD=

# --- Usuario administrador inicial (se crea al hacer seed) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
